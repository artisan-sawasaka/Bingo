; Engine configuration file.
; Godot 4.7.2 stable (Standard / GDScript only)

config_version=5

[application]

config/name="Bingo Drum 3D"
config/description="3D bingo drawing machine for TV with a smartphone lever remote."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/use_custom_user_dir=true
config/custom_user_dir_name="BingoDrum3D"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
run/low_processor_mode=false
boot_splash/bg_color=Color(0.05, 0.06, 0.1, 1)
boot_splash/show_image=false

[debug]

file_logging/enable_file_logging=true
file_logging/enable_file_logging.pc=true
file_logging/max_log_files=10

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/energy_saving/keep_screen_on=true

[gui]

common/drop_mouse_on_gui_input_disabled=true

[rendering]

rendering_device/fallback_to_d3d12=true
rendering_device/fallback_to_opengl3=true
anti_aliasing/quality/msaa_3d=2
environment/defaults/default_clear_color=Color(0.05, 0.06, 0.1, 1)
